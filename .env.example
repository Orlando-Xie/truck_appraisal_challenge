# Vision. At least one of these is required for real photo analysis.
# Without a key the pipeline still runs, using a deterministic stub, so the
# gates, the pricing model and the UI can all be developed offline.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional overrides. Leave blank to auto-pick from the live model list.
# GEMINI_FLASH_MODELS=gemini-2.5-flash,gemini-2.0-flash
# VISION_PROVIDER=auto
# GEMINI_USE_PRO=0

# Turkish FX fallback if calibration has not been run.
# EUR_TRY=47.5
# TURKIYE_MULTIPLIER=1.30
